{
  "name": "claude-aseprite-connector",
  "version": "1.0.0",
  "description": "Claude Code connector (MCP server) for creating 2D pixel art in Aseprite",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:headless": "vitest run tests/headless",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "pretest": "npm run build",
    "pretest:headless": "npm run build",
    "setup": "npm run build && node scripts/setup.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "aseprite-mcp": "dist/index.js"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aseprite",
    "mcp",
    "claude",
    "pixel-art",
    "model-context-protocol",
    "game-assets"
  ],
  "author": "Zachary Reggio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zreggio/claude-aseprite-connector.git"
  },
  "homepage": "https://github.com/zreggio/claude-aseprite-connector#readme",
  "bugs": {
    "url": "https://github.com/zreggio/claude-aseprite-connector/issues"
  }
}
